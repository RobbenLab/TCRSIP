convert_deltaG_to_Kd(scan$WT_affinity)
convert_deltaG_to_Kd <- function(deltaG, temp_celsius = 25, unit = "J") {
# R is gas constant: 8.314 J/(mol*K) or 0.001987 kcal/(mol*K)
R <- ifelse(unit == "kcal", 0.001987, 8.314)
T_kelvin <- temp_celsius + 273.15
# Kd = exp(deltaG / (R * T))
Kd <- exp(deltaG / (R * T_kelvin))
return(Kd)
}
convert_deltaG_to_Kd(scan$WT_affinity)
convert_deltaG_to_Kd(scan$WT_affinity,unit = "kcal")
within(scan,WT_kd <- convert_deltaG_to_Kd(scan$WT_affinity,unit = "kcal"))
within(within(scan,WT_kd <- convert_deltaG_to_Kd(scan$WT_affinity,unit = "kcal")),MUT_kd <- convert_deltaG_to_Kd(scan$MUT_affinity,unit = "kcal"))
scan <- within(within(scan,WT_kd <- convert_deltaG_to_Kd(scan$WT_affinity,unit = "kcal")),MUT_kd <- convert_deltaG_to_Kd(scan$MUT_affinity,unit = "kcal"))
write.table(scan,"D://Lab/CleanGit/TCRSIP/data/Scanning/scan_complete.csv")
